<!doctype html>
<html lang="es">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description"
    content="VOIP VC Dashboard - Control remoto de llamadas y gestión de campañas de voz directa desde tu navegador." />
  <title>GESTION DE LLAMADAS</title>
  <link rel="icon" type="image/png" href="/logo-vc-color.png?v=20260810" />

  <!-- Modern Typography -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/styles.css?v=20260810-modular-layout" />

  <!-- Libraries (Loaded dynamically at bottom for multi-domain support) -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/mammoth/1.6.0/mammoth.browser.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/jspdf@2.5.1/dist/jspdf.umd.min.js"></script>
</head>

<body>
  <video class="app-background-video" autoplay muted loop playsinline preload="auto" aria-hidden="true">
    <source src="/background.mp4" type="video/mp4" />
  </video>
  <div class="app-background-overlay" aria-hidden="true"></div>
  <main class="layout">
    <section class="panel">

      <!-- HEADER -->
      <div class="app-header">
        <div class="app-logo app-logo-wide"><img src="/logo-vc-color.png" alt="Logo ViaVox VC" /></div>
        <div class="app-title">
          <h1> GESTION DE LLAMADAS VC </h1>
          <p>Campañas y llamadas desde dispositivos Android</p>
        </div>
      </div>

      <!-- APK MANAGEMENT BAR -->
      <div id="apkBar" class="apk-bar">
        <div class="apk-info">
          <img class="apk-icon-img" src="/logotipo-VCMAS.ico" alt="VC icono" width="22" height="22" />
          <div>
            <strong id="apkName">Phone-VC Android</strong>
            <small id="apkMeta" class="muted">Cargando info del APK…</small>
          </div>
        </div>
        <div class="apk-actions">
          <a id="apkDownloadBtn" href="/api/apk/download" class="btn-apk-dl" download>
            ⬇️ Descargar APK
          </a>
        </div>
      </div>
      <input id="sessionCode" type="hidden" />

      <!-- STATUS -->
      <div class="status-pill" id="status">
        <span class="status-dot" id="statusDot"></span>
        <span id="statusText">Preparando sesión automática...</span>
      </div>

      <section class="shift-management" id="shiftManagement">
        <div class="shift-management-info">
          <span>GESTIÓN DE SESIÓN</span>
          <strong id="currentShiftLabel">Detectando turno...</strong>
          <small id="currentShiftSchedule">Horario de Lima</small>
        </div>
        <div class="shift-management-actions">
          <button id="finalizeTurnBtn" class="secondary">FINALIZAR TURNO</button>
          <button id="finalizeSessionBtn" class="danger-soft">FINALIZAR SESIÓN</button>
        </div>
      </section>
      <section id="shiftHistoryPanel" class="shift-history-panel" aria-live="polite"></section>

      <!-- QR BLOCK -->
      <div class="qr-block" id="qrBlock">
        <div class="pairing-slots-head">
          <div>
            <p class="qr-eyebrow">Vinculación Android</p>
            <h3 class="qr-title">Vincula tus teléfonos</h3>
            <p class="muted qr-description">Cada dispositivo debe escanear un código QR diferente.</p>
          </div>
          <button id="addPairingQrBtn" class="secondary">+ Crear QR</button>
        </div>
        <div id="pairingSlots" class="pairing-slots-grid">
          <div class="campaign-list-empty">Generando códigos QR...</div>
        </div>
      </div>

      <section class="general-call-module" aria-label="Llamada general">
        <div class="general-call-controls qr-general-call-controls">
          <div class="general-call-heading">
            <strong>Llamada general</strong>
            <span>Inicia las llamadas en todos los teléfonos disponibles.</span>
          </div>
          <div class="campaign-actions">
            <button id="campaignStopBtn" class="danger-soft">■ Detener</button>
            <button id="campaignReportBtn" class="secondary">⬇ Reporte</button>
            <button id="campaignStartBtn">▶ Iniciar llamada general</button>
            <button id="pendingTurnCallBtn" class="secondary">☎ Llamar números pendientes</button>
            <button id="campaignPauseBtn" class="secondary">⏸ Pausar</button>
            <button id="campaignResumeBtn" class="secondary">⏯ Continuar</button>
            <button id="campaignSkipBtn" class="secondary">⏭ Saltar</button>
          </div>
        </div>
      </section>

      <!-- CONTACTS SECTION -->
      <section id="contactsSection" style="display:none">
        <div class="contacts-tabs" id="contactsTabs"></div>

        <div class="contacts-topbar">
          <p class="section-title contacts-title">📋 Contactos</p>
          <div class="called-counter">
            <span>Contactos llamados</span>
            <strong id="calledContactsValue">0</strong>
          </div>
        </div>
        <div class="contact-actions">
          <button id="deleteAllContactsBtn" class="danger-soft">🗑️ Eliminar todo</button>
          <input id="filterInput" placeholder="Filtrar por nombre o número..." style="flex:1" />
        </div>

        <!-- IMPORT PANEL -->
        <div class="import-panel">
          <p class="section-title" style="margin-top:0;">📥 Crear lista importando contactos</p>

          <div class="import-tabs">
            <button id="tabWord" class="import-tab active" data-tab="word">📄 Word / Excel</button>
            <button id="tabUrl" class="import-tab" data-tab="url">🌐 Desde URL</button>
          </div>

          <!-- WORD IMPORT -->
          <div id="importPanelWord" class="import-body">
            <p class="muted" style="font-size:12px;margin-bottom:8px;">
              Sube un archivo <strong>.docx</strong>, <strong>.xlsx</strong> o <strong>.csv</strong>. Al confirmar se solicitará el nombre de la lista.
              Se detectarán columnas: <em>Nombre / Name, Teléfono / Phone / Tel / Celular, Nota</em>.
            </p>
            <div class="row" style="align-items:center;">
              <label class="file-label" for="importFile">
                📂 Seleccionar archivo
                <input id="importFile" type="file" accept=".docx,.csv,.txt,.xlsx" hidden />
              </label>
              <span id="importFileName" class="muted" style="font-size:13px;">Ninguno seleccionado</span>
            </div>
          </div>

          <!-- URL IMPORT -->
          <div id="importPanelUrl" class="import-body" style="display:none">
            <p class="muted" style="font-size:12px;margin-bottom:8px;">
              Pega una URL de página web con tabla o lista de contactos. Se detectarán cabeceras automáticamente.
            </p>
            <div class="row">
              <input id="importUrl" placeholder="https://..." style="flex:1;min-width:200px;" />
              <button id="importUrlBtn">🔍 Importar</button>
            </div>
          </div>

          <!-- PREVIEW -->
          <div id="importPreview" style="display:none;margin-top:12px;">
            <p class="section-title" style="margin-top:0;">Vista previa — <span id="previewCount">0</span> contactos
              detectados</p>
            <div class="table-wrap" style="max-height:200px;overflow-y:auto;">
              <table>
                <thead>
                  <tr>
                    <th>Nombre</th>
                    <th>Teléfono</th>
                  </tr>
                </thead>
                <tbody id="previewBody"></tbody>
              </table>
            </div>
            <div class="row" style="margin-top:10px;">
              <button id="importConfirmBtn">✅ Agregar todos (importar)</button>
              <button id="importCancelBtn" class="secondary">✕ Cancelar</button>
            </div>
          </div>
        </div>

        <!-- CONTACTS TABLE -->
        <div class="table-wrap contacts-table-wrap" style="margin-top:16px;">
          <table>
            <thead>
              <tr>
                <th>Nombre</th>
                <th>Teléfono</th>
                <th>Contactar</th>
              </tr>
            </thead>
            <tbody id="contactsBody"></tbody>
          </table>
        </div>
        <div id="contactsPagination" class="pagination" style="display:none">
          <button id="prevPageBtn" class="secondary">← Anterior</button>
          <span id="pageInfo" class="muted">Página 1 de 1</span>
          <button id="nextPageBtn" class="secondary">Siguiente →</button>
        </div>
      </section>

      <section id="pendingTurnPanel" class="pending-turn-panel" aria-live="polite">
        <div class="pending-turn-head">
          <div>
            <span>PENDIENTES DEL TURNO</span>
            <h3>Números pendientes del turno</h3>
          </div>
          <strong id="pendingTurnCount">0 pendientes</strong>
        </div>
        <div class="pending-turn-table-wrap">
          <table>
            <thead><tr><th>LISTA</th><th>EMPRESA</th><th>TELÉFONO</th><th>CONTACTO</th></tr></thead>
            <tbody id="pendingTurnBody"><tr><td colspan="4">No hay números pendientes.</td></tr></tbody>
          </table>
        </div>
      </section>

      <section id="assignedListsPanel" class="assigned-lists-panel" aria-live="polite">
        <div class="campaign-list-empty">Las listas asignadas aparecerán aquí.</div>
      </section>

    </section>
  </main>

  <div id="reminderFloatContainer" class="reminder-float-container" style="display:none" aria-live="polite"></div>

  <!-- EDIT CONTACT MODAL -->
  <div id="editContactModal" class="edit-modal" style="display:none">
    <div class="edit-card">
      <button id="editCloseBtn" class="edit-close-btn" type="button" aria-label="Cerrar">✕</button>
      <h3>Editar contacto</h3>
      <div class="edit-form">
        <label for="editNameInput">Nombre</label>
        <input id="editNameInput" type="text" placeholder="Nombre" />

        <label for="editPhoneInput">Teléfono</label>
        <input id="editPhoneInput" type="text" placeholder="+51999999999" />

        <label for="editNoteInput">Nota</label>
        <input id="editNoteInput" type="text" placeholder="Nota (opcional)" list="noteOptions" />
      </div>
      <button id="editSaveBtn" type="button">💾 Guardar cambios</button>
    </div>
  </div>

  <!-- WHATSAPP MODAL -->
  <div id="whatsappModal" class="edit-modal" style="display:none">
    <div class="edit-card whatsapp-card">
      <button id="whatsappCloseBtn" class="edit-close-btn" type="button" aria-label="Cerrar">✕</button>
      <h3 id="whatsappTitle">WhatsApp</h3>
      <p id="whatsappPhone" class="muted whatsapp-phone">-</p>

      <div id="whatsappQrPanel" class="whatsapp-panel" style="display:none">
        <p id="whatsappQrLead" class="muted" style="font-size:13px;">Escanea este QR para vincular WhatsApp.</p>
        <div id="whatsappConnectOk" class="wa-connect-ok" style="display:none;">
          <strong>Cuenta conectada</strong>
          <small id="whatsappLinkedNumber">-</small>
        </div>
        <img id="whatsappQrImg" alt="QR WhatsApp" style="display:none" />
        <small id="whatsappQrHint" class="muted">Cargando estado de WhatsApp...</small>
        <div class="row" style="margin-top:10px;justify-content:flex-start;">
          <button id="whatsappLogoutBtn" type="button" class="secondary" style="display:none;">Cerrar sesión</button>
        </div>
      </div>

      <div id="whatsappFormPanel" class="whatsapp-panel" style="display:none">
        <label>Mensajes predeterminados</label>
        <div class="whatsapp-template-create-row">
          <input id="whatsappTemplateInput" type="text" placeholder="Escribe un mensaje predeterminado..." />
          <button id="whatsappTemplateSaveBtn" type="button" class="secondary">💾 Guardar</button>
        </div>
        <div id="whatsappTemplates" class="whatsapp-templates"></div>

        <label for="whatsappMessageInput">Mensaje</label>
        <textarea id="whatsappMessageInput" rows="4" placeholder="Escribe tu mensaje..."></textarea>

        <label>Archivo (opcional)</label>
        <div id="whatsappDropZone" class="whatsapp-drop-zone">
          <div class="drop-zone-content">
            <span class="drop-icon">📁</span>
            <span id="whatsappFileName" class="drop-text">Arrastra un archivo aquí o haz clic</span>
          </div>
          <input id="whatsappFileInput" type="file"
            accept="image/*,.pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt,.csv,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-powerpoint,application/vnd.openxmlformats-officedocument.presentationml.presentation,text/plain,text/csv"
            hidden />
        </div>

        <button id="whatsappSendBtn" type="button">Enviar por WhatsApp</button>
      </div>
    </div>
  </div>

  <!-- LIST NAME MODAL (replaces window.prompt for embedded browsers) -->
  <div id="listNameModal" class="edit-modal" style="display:none">
    <div class="edit-card list-name-card" role="dialog" aria-modal="true" aria-labelledby="listNameTitle">
      <button id="listNameCloseBtn" class="edit-close-btn" type="button" aria-label="Cerrar">✕</button>
      <h3 id="listNameTitle">Nueva lista</h3>
      <div class="edit-form">
        <label for="listNameInput">Nombre de la lista</label>
        <input id="listNameInput" type="text" maxlength="80" autocomplete="off" placeholder="Ej. Avícolas" />
      </div>
      <p id="listNameError" class="list-name-error" role="alert"></p>
      <div class="row" style="justify-content:flex-end;margin-top:12px;">
        <button id="listNameCancelBtn" type="button" class="secondary">Cancelar</button>
        <button id="listNameSaveBtn" type="button">Guardar</button>
      </div>
    </div>
  </div>

  <!-- GENERIC CONFIRMATION MODAL -->
  <div id="confirmModal" class="edit-modal" style="display:none">
    <div class="edit-card list-name-card" role="dialog" aria-modal="true" aria-labelledby="confirmTitle">
      <button id="confirmCloseBtn" class="edit-close-btn" type="button" aria-label="Cerrar">✕</button>
      <h3 id="confirmTitle">Confirmar acción</h3>
      <p id="confirmMessage" class="confirm-message"></p>
      <div class="row" style="justify-content:flex-end;margin-top:18px;">
        <button id="confirmCancelBtn" type="button" class="secondary">Cancelar</button>
        <button id="confirmAcceptBtn" type="button">Aceptar</button>
      </div>
    </div>
  </div>

  <!-- QUOTATION MODAL -->
  <div id="quotationModal" class="edit-modal" style="display:none">
    <div class="edit-card quotation-card">
      <button id="quotationCloseBtn" class="edit-close-btn" type="button" aria-label="Cerrar">✕</button>
      <h3>Nueva Cotización</h3>
      <p class="muted" style="margin-bottom:10px;">Sin PHP. Se genera y descarga directamente desde el navegador.</p>

      <div class="edit-form quotation-form-grid">
        <label for="qDate">Fecha</label>
        <input id="qDate" type="date" />

        <label for="qCompany">Empresa / Razón Social</label>
        <input id="qCompany" type="text" placeholder="Empresa" />

        <label for="qRuc">RUC</label>
        <input id="qRuc" type="text" placeholder="RUC" />

        <label for="qPhone">Teléfono</label>
        <input id="qPhone" type="text" placeholder="+51999999999" />

        <label for="qEmail">Correo</label>
        <input id="qEmail" type="email" placeholder="correo@dominio.com" />

        <label for="qAddress">Dirección</label>
        <input id="qAddress" type="text" placeholder="Dirección" />
      </div>

      <div class="table-wrap quotation-table-wrap">
        <table>
          <thead>
            <tr>
              <th>Servicio / Producto</th>
              <th>Cantidad</th>
              <th>Precio</th>
              <th>Total</th>
              <th>Acciones</th>
            </tr>
          </thead>
          <tbody id="quotationItemsBody"></tbody>
        </table>
      </div>

      <div class="row" style="margin-top:10px;">
        <button id="quotationAddItemBtn" type="button" class="secondary">＋ Agregar ítem</button>
      </div>

      <div class="quotation-totals">
        <label class="quotation-igv-label">
          <input id="quotationApplyIgv" type="checkbox" />
          <span>Aplicar IGV (18%)</span>
        </label>
        <div class="quotation-total-line"><span>Subtotal:</span><strong id="quotationSubtotal">S/ 0.00</strong></div>
        <div class="quotation-total-line"><span>IGV:</span><strong id="quotationIgv">S/ 0.00</strong></div>
        <div class="quotation-total-line grand"><span>Total:</span><strong id="quotationTotal">S/ 0.00</strong></div>
      </div>

      <div class="row" style="justify-content:flex-end;">
        <button id="quotationPreviewBtn" type="button" class="secondary">👁️ Vista previa</button>
        <button id="quotationDownloadBtn" type="button">💾 Descargar PDF</button>
      </div>
    </div>
  </div>

  <!-- QUOTATION PREVIEW MODAL -->
  <div id="quotationPreviewModal" class="edit-modal quotation-preview-modal" style="display:none">
    <div class="edit-card quotation-preview-card">
      <button id="quotationPreviewCloseBtn" class="edit-close-btn" type="button" aria-label="Cerrar">✕</button>
      <div class="quotation-preview-actions">
        <button id="quotationPreviewDownloadBtn" type="button">💾 Descargar PDF</button>
        <span id="quotationSendFeedback" class="quotation-send-feedback" aria-live="polite"></span>
      </div>
      <iframe id="quotationPreviewFrame" class="quotation-preview-frame" title="Vista previa cotización"></iframe>
    </div>
  </div>

  <datalist id="noteOptions">
    <option value="No contestó"></option>
    <option value="Llamar mañana"></option>
    <option value="Llamar el lunes"></option>
    <option value="Llamar en 2 horas"></option>
    <option value="Llamar 25/02/2026"></option>
    <option value="Llamar 2026-02-25 15:30"></option>
  </datalist>
  <datalist id="quotationServicesDatalist"></datalist>

  <!-- CALL MODAL -->
  <div id="callModal" class="call-modal" style="display:none">
    <div class="call-card">
      <div class="call-pulse-ring" id="callRing">
        <img src="/logotipo-VCMAS.ico" alt="VC logo" />
      </div>
      <div class="call-card-inner">
        <p class="call-kicker" id="callKicker">Llamando...</p>
        <h3 id="callName">Sin contacto</h3>
        <p class="call-number" id="callNumber">-</p>
        <p class="call-note" id="callNote">-</p>

        <div class="call-meta">
          <span id="callStateBadge" class="badge">idle</span>
          <span id="callDuration" style="font-variant-numeric:tabular-nums;font-weight:600;font-size:16px;">00:00</span>
          <span id="micBadge" class="mic-indicator muted">🎙️ —</span>
          <span id="apkAckBadge" class="badge">APK · —</span>
        </div>

        <div class="call-controls">
          <button id="modalMuteBtn" class="secondary" title="Silenciar micrófono">🎙️ Micrófono</button>
          <button id="modalSpeakerBtn" class="secondary" title="Altavoz">🔊 Altavoz</button>
        </div>

        <div class="call-controls call-controls-main">
          <button id="modalHangupBtn" class="danger">📵 Cortar</button>
        </div>

        <small id="callHint" class="muted" style="display:block;margin-top:12px;font-size:12px;"></small>
      </div>
    </div>
  </div>


  <!-- CALL HISTORY MODAL -->
  <div id="callHistoryModal" class="edit-modal" style="display:none">
    <div class="edit-card history-card">
      <button id="historyCloseBtn" class="edit-close-btn" type="button">✕</button>
      <div class="history-header">
        <h3>📜 Historial Reciente</h3>
        <button id="clearHistoryBtn" class="secondary" style="font-size:11px;">Limpiar</button>
      </div>
      <div id="historyList" class="history-list">
        <div class="muted" style="text-align:center;padding:40px;">Sin llamadas recientes.</div>
      </div>
    </div>
  </div>

  <script>
    (function bootstrapDashboard() {
      const params = new URLSearchParams(window.location.search);
      function resolveApiBase() {
        const fromQuery = String(params.get("apiBase") || "").trim();
        if (fromQuery) return fromQuery.replace(/\/+$/, "");

        const hostname = window.location.hostname;

        // Local detection
        if (hostname === "localhost" || hostname === "127.0.0.1" || hostname.startsWith("192.168.")) {
          return window.location.origin;
        }

        // Production mapping
        if (hostname === "llamada.viacomunicativa.com") {
          return "https://llamada.viacomunicativa.com";
        }

        return window.location.origin;
      }

      const apiBase = resolveApiBase();
      window.VOIP_VC_API_BASE = apiBase;

      const socketScript = document.createElement("script");
      socketScript.src = `${apiBase}/socket.io/socket.io.js`;
      socketScript.onload = () => {
        import("/dashboard.js?v=20260810-compact-tables");
      };
      socketScript.onerror = () => {
        console.error("No se pudo cargar Socket.IO desde", socketScript.src);
        const statusText = document.getElementById("statusText");
        if (statusText) {
          statusText.textContent = `No se pudo conectar al backend en ${apiBase}.`;
        }
      };
      document.body.appendChild(socketScript);
    })();
  </script>
</body>

</html>
