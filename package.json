{
  "name": "voip-vc-call-bridge-skeleton",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "auth:local": "node backend/services/auth/local.js",
    "auth:setup": "node backend/services/auth/local.js --setup-only",
    "auth:mysql:stop": "node backend/services/auth/stop-local-mysql.js",
    "auth:user:add": "node backend/services/auth/create-user.js",
    "test:auth": "node --test backend/__tests__/auth/*.test.js",
    "test:network": "node --test backend/__tests__/architecture/contracts.test.js",
    "start": "node backend/index.js",
    "migrate:history": "node backend/scripts/migrate-call-history.js",
    "backup:history": "node backend/scripts/migrate-call-history.js --backup-only",
    "restore:history": "node backend/scripts/migrate-call-history.js --restore",
    "dev": "node --watch backend/index.js",
    "start:web": "node backend/index.js",
    "dev:web": "node --watch backend/index.js",
    "start:calls": "node backend/index.js",
    "build:figma-plugin": "tsc -p figma-plugin/tsconfig.json",
    "test": "node --experimental-vm-modules --test backend/__tests__/*/*.test.js frontend/app/navigation/*.test.js",
    "test:web": "node --experimental-vm-modules --test backend/__tests__/architecture/frontend.test.js frontend/app/navigation/*.test.js",
    "test:contracts": "node --test backend/__tests__/architecture/contracts.test.js"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "figma-js": "^1.16.1-0",
    "multer": "^2.5.0",
    "mysql2": "^3.12.0",
    "nanoid": "^5.1.5",
    "node-fetch": "^3.3.2",
    "nodemailer": "^10.6.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.142.0",
    "typescript": "^7.0.2"
  }
}
