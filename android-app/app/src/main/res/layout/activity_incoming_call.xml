<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/callScreenRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vc_bg"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="24dp"
    android:paddingEnd="24dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_company_image"
            android:gravity="center"
            android:text="VC"
            android:textColor="@color/vc_text_inverse"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VOIP VC"
                android:textColor="@color/vc_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/headerCallSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Controles de llamada"
                android:textColor="@color/vc_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/headerCallStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_success"
            android:paddingStart="12dp"
            android:paddingTop="7dp"
            android:paddingEnd="12dp"
            android:paddingBottom="7dp"
            android:text="CONECTADA"
            android:textColor="@color/vc_success"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="0dp">

        <Space
            android:id="@+id/callTopSpacer"
            android:layout_width="match_parent"
            android:layout_height="0dp" />

        <TextView
            android:id="@+id/callScreenTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Llamada entrante"
            android:textColor="@color/vc_text_primary"
            android:textSize="23sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/callScreenHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Responde o rechaza esta llamada."
            android:textColor="@color/vc_text_secondary"
            android:textSize="12sp"
            android:visibility="gone" />

        <FrameLayout
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:background="@drawable/bg_contact_avatar">

            <ImageView
                android:id="@+id/companyImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:padding="20dp"
                android:scaleType="centerInside"
                android:tint="@color/vc_accent"
                android:src="@android:drawable/sym_call_incoming"
                android:visibility="gone" />

            <TextView
                android:id="@+id/companyInitials"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="VC"
                android:textColor="@color/vc_accent"
                android:textSize="22sp"
                android:textStyle="bold" />
        </FrameLayout>

        <TextView
            android:id="@+id/companyNameText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Contacto"
            android:textColor="@color/vc_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/phoneNumberText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="-"
            android:textColor="@color/vc_text_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/callStateText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_state_chip"
            android:paddingLeft="14dp"
            android:paddingTop="6dp"
            android:paddingRight="14dp"
            android:paddingBottom="6dp"
            android:text="LLAMANDO"
            android:textColor="@color/vc_text_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/callTimerText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="00:00 · EN LLAMADA"
            android:textColor="@color/vc_success"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/audioControlsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/micButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_secondary_button"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Micrófono"
                android:textAllCaps="false"
                android:textColor="@color/vc_text_primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/speakerButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_secondary_button"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Altavoz"
                android:textAllCaps="false"
                android:textColor="@color/vc_text_primary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ringingActionsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/answerButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_success_button"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Contestar"
                android:textAllCaps="false"
                android:textColor="@color/vc_text_inverse"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/hangupButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_danger_button"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Colgar"
                android:textAllCaps="false"
                android:textColor="@color/vc_text_inverse" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/contactActionsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/messageButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_secondary_button"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Mensaje"
                android:textAllCaps="false"
                android:textColor="@color/vc_text_primary"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/quoteButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_primary_button"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Cotizar"
                android:textAllCaps="false"
                android:textColor="@color/vc_text_inverse"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/scheduleButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_secondary_button"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Agendar"
                android:textAllCaps="false"
                android:textColor="@color/vc_text_primary"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/callActionsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/blockButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_danger_soft"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Bloquear"
                android:textAllCaps="false"
                android:textColor="@color/vc_error" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/endCallButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_danger_button"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Colgar"
                android:textAllCaps="false"
                android:textColor="@color/vc_text_inverse" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
