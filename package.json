{
  "name": "voip-vc-call-bridge-skeleton",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "panel:dev": "npm --prefix frontend run dev",
    "panel:build": "npm --prefix frontend run build",
    "auth:local": "node server/auth/local.js",
    "auth:setup": "node server/auth/local.js --setup-only",
    "auth:mysql:stop": "node server/auth/stop-local-mysql.js",
    "auth:user:add": "node server/auth/create-user.js",
    "test:auth": "node --test server/auth/auth.integration.test.js",
    "test:network": "node --test server/network-monitor.test.js",
    "start": "node server/server.js",
    "migrate:history": "node server/migrate-call-history.js",
    "backup:history": "node server/migrate-call-history.js --backup-only",
    "restore:history": "node server/migrate-call-history.js --restore",
    "dev": "node --watch server/server.js",
    "start:web": "node server/server.js",
    "dev:web": "node --watch server/server.js",
    "start:calls": "node server/server.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mysql2": "^3.12.0",
    "nanoid": "^5.1.5",
    "node-fetch": "^3.3.2",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.1"
  }
}
