# Plantilla para las variables del servicio en EasyPanel.
# Usa el host interno del servicio MySQL; nunca uses localhost aquí.
APP_ENV=easypanel
PORT=3000
PUBLIC_BASE_URL=https://REEMPLAZAR-POR-TU-DOMINIO

DB_HOST=REEMPLAZAR-POR-HOST-INTERNO-MYSQL
DB_PORT=3306
DB_NAME=REEMPLAZAR-POR-BASE-DE-PRODUCCION
DB_USER=REEMPLAZAR-POR-USUARIO-MYSQL
DB_PASSWORD=REEMPLAZAR-EN-EASYPANEL
DB_SSL=false
DB_POOL_LIMIT=50
NETWORK_MONITOR_INTERVAL_MS=30000
SOCKET_PING_INTERVAL_MS=30000
SOCKET_PING_TIMEOUT_MS=60000
