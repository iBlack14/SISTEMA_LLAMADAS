# Copia estas variables en .env; nunca publiques las credenciales.
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
# Usa true si tu servicio MySQL ofrece TLS con certificado verificable.
DB_SSL=false

# Copias del historial y de las sesiones; el directorio debe ser privado.
CALL_BACKUP_INTERVAL_HOURS=24
# CALL_BACKUP_DIR=/ruta/privada/fuera/del/directorio/web/backups

# MySQL es obligatorio para sesiones e historial. No se usa SESSIONS_FILE.
