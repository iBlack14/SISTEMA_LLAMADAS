NODE_ENV=production
HOST=127.0.0.1
PORT=3101
PUBLIC_BASE_URL=https://llamadas.vitorinocasas.com
PUBLIC_WEB_BASE_URL=https://llamadas.vitorinocasas.com
CORS_ORIGIN=https://llamadas.vitorinocasas.com
TRUST_PROXY=1
SESSIONS_FILE=/var/lib/voip-vc/sessions.json
MAX_JSON_SIZE=256kb
FETCH_TIMEOUT_MS=10000
SESSION_TTL_MS=2592000000
DISCONNECTED_SESSION_TTL_MS=86400000
SOCKET_MAX_HTTP_BUFFER_SIZE=1048576
SOCKET_PING_INTERVAL_MS=25000
SOCKET_PING_TIMEOUT_MS=20000
KEEP_ALIVE_TIMEOUT_MS=65000
HEADERS_TIMEOUT_MS=66000
REQUEST_TIMEOUT_MS=30000
